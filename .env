# ============================================================================
# LEARNER ACHIEVEMENT RECORDS SYSTEM (LARS) - ENVIRONMENT CONFIGURATION
# ============================================================================
# National education data infrastructure owned and managed by
# Zambia Qualifications Authority (ZAQA)
#
# System Purpose: Store learner records to assist with verification of qualifications
#
# Lead Developer: amcodecase (justus.michelo@zaqa.gov.zm)
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
# Application environment (development, staging, production)
APP_ENV=

# Application name and version
APP_NAME="Learner Achievement Records System"
APP_VERSION=1.0.0

# Application URL (no trailing slash)
APP_URL=lars.zaqa.gov.zm

# Application timezone
APP_TIMEZONE=Africa/Lusaka

# Debug mode (true/false) - NEVER set to true in production
APP_DEBUG=true

# Application key for encryption (generate unique key for each environment)
APP_KEY=

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Primary database connection
DB_CONNECTION=mysql
DB_HOST=srv941.hstgr.io
DB_PORT=3306
DB_DATABASE=u178619125_zaqa_lars
DB_USERNAME=u178619125_zaqa_lars
DB_PASSWORD=@Bludiamond0100

# Database charset and collation
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ----------------------------------------------------------------------------
# CACHE CONFIGURATION
# ----------------------------------------------------------------------------
# Cache driver (file, redis, memcached)
CACHE_DRIVER=

# Cache prefix for key namespacing
CACHE_PREFIX=lars_

# Cache default TTL in seconds
CACHE_TTL=3600

# ----------------------------------------------------------------------------
# SESSION CONFIGURATION
# ----------------------------------------------------------------------------
# Session driver (file, database, redis)
SESSION_DRIVER=

# Session lifetime in minutes
SESSION_LIFETIME=120

# Session cookie name
SESSION_COOKIE=lars_session

# Session encryption
SESSION_ENCRYPT=true

# ----------------------------------------------------------------------------
# SECURITY SETTINGS
# ----------------------------------------------------------------------------
# Hash algorithm for passwords
HASH_ALGO=bcrypt

# Hash rounds/cost (higher = more secure, slower)
HASH_ROUNDS=12

# CSRF token name
CSRF_TOKEN_NAME=csrf_token

# Password reset token expiry (in minutes)
PASSWORD_RESET_EXPIRY=60

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=300

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------
# Mail driver (smtp, sendmail, mail)
MAIL_DRIVER=

# SMTP settings
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=justus.michelo@zaqa.gov.zm
MAIL_PASSWORD=@Bludiamond0100
MAIL_ENCRYPTION=tls

# Default sender information
MAIL_FROM_ADDRESS=justus.michelo@zaqa.gov.zm
MAIL_FROM_NAME="Learner Records - ZAQA"

# ----------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# ----------------------------------------------------------------------------
# Default filesystem disk
FILESYSTEM_DISK=local

# Upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=csv,xlsx

# Document storage paths
UPLOADS_PATH=uploads/
CERTIFICATES_PATH=certificates/
TRANSCRIPTS_PATH=transcripts/

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# API version
API_VERSION=v1

# API authentication timeout (minutes)
API_AUTH_TIMEOUT=60

# ----------------------------------------------------------------------------
# ZAQA INTEGRATION SETTINGS
# ----------------------------------------------------------------------------
# ZAQA institutional identifier
ZAQA_INSTITUTION_ID=

# ZAQA API endpoints
ZAQA_API_BASE_URL=
ZAQA_API_KEY=
ZAQA_API_SECRET=

# Qualification verification endpoints
ZAQA_VERIFY_ENDPOINT=
ZAQA_REGISTER_ENDPOINT=

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log level (emergency, alert, critical, error, warning, notice, info, debug)
LOG_LEVEL=info

# Log channel (single, daily, syslog)
LOG_CHANNEL=daily

# Log file retention (days)
LOG_RETENTION_DAYS=30

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_CHANNEL=audit

# ----------------------------------------------------------------------------
# NOTIFICATION SETTINGS
# ----------------------------------------------------------------------------
# SMS gateway configuration
SMS_DRIVER=
SMS_API_KEY=
SMS_SENDER_ID=ZAQA

# Push notification settings
PUSH_ENABLED=false
PUSH_API_KEY=

# ----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ----------------------------------------------------------------------------
# Backup storage disk
BACKUP_DISK=

# Backup schedule (daily, weekly)
BACKUP_SCHEDULE=daily

# Backup retention (days)
BACKUP_RETENTION=90

# Database backup encryption
BACKUP_ENCRYPT=true

# ----------------------------------------------------------------------------
# MONITORING AND ANALYTICS
# ----------------------------------------------------------------------------
# Error tracking
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=

# Performance monitoring
PERFORMANCE_MONITORING=false

# Analytics tracking
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=

# ----------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# ----------------------------------------------------------------------------
# Ministry of Education integration
MOE_API_ENDPOINT=
MOE_API_KEY=

# Higher Education Authority integration
HEA_API_ENDPOINT=
HEA_API_KEY=

# Technical Education integration
TEVETA_API_ENDPOINT=
TEVETA_API_KEY=

# ----------------------------------------------------------------------------
# SYSTEM MAINTENANCE
# ----------------------------------------------------------------------------
# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."

# System health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_SECRET=

# ----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS (Remove in production)
# ----------------------------------------------------------------------------
# Development tools
DEV_TOOLBAR=false
DEV_PROFILER=false

# Test database (only for testing environment)
TEST_DB_CONNECTION=
TEST_DB_DATABASE=

# ----------------------------------------------------------------------------
# CUSTOM LARS SETTINGS
# ----------------------------------------------------------------------------
# Qualification verification settings
AUTO_VERIFY_QUALIFICATIONS=false
MANUAL_VERIFICATION_REQUIRED=true

# Learner record settings
ALLOW_SELF_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=true

# Certificate generation
CERTIFICATE_TEMPLATE_PATH=templates/certificates/
DIGITAL_SIGNATURE_ENABLED=true

# Record retention policy (years)
RECORD_RETENTION_YEARS=50

# System administrator contact
SYSTEM_ADMIN_EMAIL=justus.michelo@zaqa.gov.zm
SYSTEM_ADMIN_NAME="amcodecase"